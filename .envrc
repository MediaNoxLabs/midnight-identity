# Workspace-parent direnv layout: source the parent .envrc (machine-local
# credentials) when one exists. Guarded so standalone clones — where no
# ancestor .envrc exists — don't abort on source_up's "No ancestor .envrc
# found" and still get the devshell via `use flake` below.
if [[ -f ../.envrc ]]; then source_up; fi

use flake
