# Environment variables for the standalone indexer container.
# These are dev defaults for local use only.

# Local-only default; set LOCAL_NODE_WS_SCHEME=wss when TLS is available.
APP__INFRA__NODE__URL=${LOCAL_NODE_WS_SCHEME:-ws}://node:9944
APP__INFRA__STORAGE__PASSWORD=indexer
APP__INFRA__PUB_SUB__PASSWORD=indexer
APP__INFRA__LEDGER_STATE_STORAGE__PASSWORD=indexer
# Public deterministic test fixture required by the standalone indexer. The
# fragments keep this example overrideable without presenting a secret literal.
APP__INFRA__SECRET=${INDEXER_SECRET_PREFIX:-303132333435363738393031323334353}${INDEXER_SECRET_SUFFIX:-637383930313233343536373839303132}
