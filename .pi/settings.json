{
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-5.5",
  "defaultThinkingLevel": "medium",
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "retry": {
    "enabled": true,
    "maxRetries": 1,
    "baseDelayMs": 2000,
    "provider": {
      "timeoutMs": 600000,
      "maxRetries": 0,
      "maxRetryDelayMs": 60000
    }
  },
  "packages": [
    {
      "source": "npm:dev-loops@1.0.2",
      "extensions": []
    },
    "npm:pi-subagents@0.35.1",
    "npm:typebox@1.3.9"
  ],
  "subagents": {
    "projectRootResolution": "git-root",
    "defaultModel": "openai-codex/gpt-5.5",
    "defaultThinking": "medium"
  }
}
