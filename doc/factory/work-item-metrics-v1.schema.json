{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MediaNoxLabs/midnight-identity/blob/develop/doc/factory/work-item-metrics-v1.schema.json",
  "title": "midnight-libs factory work-item metrics v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repository",
    "issue",
    "pr",
    "headSha",
    "deliveryProfile",
    "model",
    "reasoningProfile",
    "startedAt",
    "completedAt",
    "durations",
    "tokens",
    "resources",
    "validations",
    "failure"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "repository": { "const": "MediaNoxLabs/midnight-identity" },
    "issue": { "type": "integer", "minimum": 1 },
    "pr": { "type": ["integer", "null"], "minimum": 1 },
    "headSha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "deliveryProfile": { "enum": ["prototype", "production-ready"] },
    "model": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$" },
    "reasoningProfile": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
    "startedAt": { "type": "string", "format": "date-time" },
    "completedAt": { "type": "string", "format": "date-time" },
    "durations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["elapsedMs", "implementationMs", "reviewMs", "ciMs", "retryMs"],
      "properties": {
        "elapsedMs": { "type": "integer", "minimum": 0 },
        "implementationMs": { "type": ["integer", "null"], "minimum": 0 },
        "reviewMs": { "type": ["integer", "null"], "minimum": 0 },
        "ciMs": { "type": ["integer", "null"], "minimum": 0 },
        "retryMs": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "tokens": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["input", "output", "cacheRead", "cacheWrite"],
          "properties": {
            "input": { "type": "integer", "minimum": 0 },
            "output": { "type": "integer", "minimum": 0 },
            "cacheRead": { "type": "integer", "minimum": 0 },
            "cacheWrite": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diskDeltaBytes", "peakWorktreeBytes", "peakTargetBytes", "peakRssBytes"],
      "properties": {
        "diskDeltaBytes": { "type": ["integer", "null"] },
        "peakWorktreeBytes": { "type": ["integer", "null"], "minimum": 0 },
        "peakTargetBytes": { "type": ["integer", "null"], "minimum": 0 },
        "peakRssBytes": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "validations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "outcome", "durationMs"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{0,63}$" },
          "kind": { "enum": ["local", "ci"] },
          "outcome": { "enum": ["passed", "failed", "canceled", "skipped"] },
          "durationMs": { "type": ["integer", "null"], "minimum": 0 }
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "retryCount"],
      "properties": {
        "classification": {
          "enum": ["none", "implementation", "review", "ci", "environment", "provider", "transport", "authority", "canceled"]
        },
        "retryCount": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    }
  }
}
